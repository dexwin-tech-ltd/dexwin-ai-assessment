# Copy this file to .env (or set the same keys in Cursor Settings →
# environment / secrets if your session uses that UI).
#
# Fixture mode needs NO key. Live mode needs a capped org key.

# true  = canned / heuristic model, no network, no spend
# false = call an OpenAI-compatible Chat Completions API
# unset = fixtures if OPENAI_API_KEY is empty, otherwise live
USE_FIXTURES=true

# Required only when USE_FIXTURES=false
OPENAI_API_KEY=

# Optional — any OpenAI-compatible gateway (OpenAI, Azure-style proxy, org router)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PORT=3000
