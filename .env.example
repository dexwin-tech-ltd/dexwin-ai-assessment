# Copy to .env if you are not injecting these via Codespaces secrets.
# Do not commit .env. Use a capped org key only — never a personal unlimited key.
#
# This file configures the Northline RAG *app under test*.
# It is not a coding-assistant key.

# Capped org OpenAI-compatible key (live Chat Completions).
# In Codespaces, prefer a repository/org secret named OPENAI_API_KEY instead.
# Codespaces secrets do not copy to forks.
OPENAI_API_KEY=

# Optional gateway + model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Fixture fallback (canned model) for retrieval/eval/guardrails with no live key.
#   true  = always use canned responses (even if a key is set)
#   false = require a live key
#   unset = live when OPENAI_API_KEY is set, otherwise fixtures
# USE_FIXTURES=true

PORT=3000
